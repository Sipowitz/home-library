# Copy this file to .env.production and replace every change-me value.
# Keep .env.production out of Git and restrict its filesystem permissions.

POSTGRES_DB=library_prod
POSTGRES_USER=library_prod
POSTGRES_PASSWORD=change-me-use-a-long-random-password

# URL-encode reserved characters in the username/password used in this URL.
# The host must remain "db", the production Compose database service.
DATABASE_URL=postgresql://library_prod:change-me-use-a-long-random-password@db:5432/library_prod

SECRET_KEY=change-me-use-a-long-random-jwt-signing-secret
LIBRARY_HTTP_PORT=8088

# Same-origin production requests do not require CORS. This is a JSON list.
# Add only exact trusted origins if a separate frontend origin is introduced.
CORS_ORIGINS=[]

COVERS_DIR=/app/covers
